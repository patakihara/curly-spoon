# Copy to ops/auralis-agent.env and edit. This file is gitignored.

# Where the repo is cloned on this server.
REPO_DIR=/opt/auralis-src

# Branch to follow.
BRANCH=claude/media-client-app-k7v9by

# How to invoke Claude Code. Use an absolute path if it is not on the timer's PATH.
CLAUDE_BIN=claude

# Tool permissions for the headless run.
#
# The default lets it edit files and run tools without prompting, but does NOT pass
# --dangerously-skip-permissions. If your Claude Code setup needs an explicit allowlist,
# add --allowedTools "Bash,Read,Write,Edit,Glob,Grep" here.
#
# Widen this only as far as you are comfortable: whatever you allow, an agent acting on
# instructions from the repo can do on this machine.
CLAUDE_ARGS=--permission-mode acceptEdits

# Only used by --loop mode; the systemd timer controls the real cadence.
POLL_SECONDS=600
