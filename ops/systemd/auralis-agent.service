[Unit]
Description=Auralis server-side agent — carry out one request from the repo
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Adjust User and WorkingDirectory to match your install.
User=%i
WorkingDirectory=/opt/auralis-src
ExecStart=/opt/auralis-src/ops/auralis-agent.sh --once
TimeoutStartSec=3600

# The agent builds and runs containers; it does not need to write outside its own tree.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
