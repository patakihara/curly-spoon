[Unit]
Description=Poll the Auralis repo for requests to carry out

[Timer]
# Ten minutes after boot, then every ten minutes. A tick with no new commits
# costs one `git fetch` and exits without invoking Claude.
OnBootSec=10min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
