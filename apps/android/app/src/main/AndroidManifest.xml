<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- AuralisDownloadService (Wave F2a) targets foregroundServiceType="dataSync" — Android's
         own foreground-service-type docs list "downloading or uploading data ... network
         operations, transfer between device and cloud" as exactly that type's purpose, and
         every foreground service type has required its own matching FOREGROUND_SERVICE_* grant
         since API 34, same as FOREGROUND_SERVICE_MEDIA_PLAYBACK above already does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required (API 33+) for AuralisDownloadService's progress notification to actually be
         visible — declared here so a future UI wave can request it at runtime; nothing in this
         wave requests it yet (see AuralisDownloadService's own doc comment), so until then the
         notification is silently invisible while the download itself still proceeds normally. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AuralisApplication"
        android:allowBackup="true"
        android:label="Auralis"
        android:theme="@style/Theme.Auralis">

        <!-- Declares this app as an Android Auto media app. The referenced descriptor
             (res/xml/automotive_app_desc.xml) is what Phase 7 will actually populate with
             browsable content; this phase only proves the declaration merges cleanly. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Auralis"
            android:theme="@style/Theme.Auralis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.AuralisMediaLibraryService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- Wave F2a. Not exported: unlike AuralisMediaLibraryService above (which Android Auto,
             an external app, must bind to), nothing outside this app ever needs to start or bind
             to the download service directly — see AuralisDownloadService's own doc comment for
             why it declares no PlatformScheduler-related intent-filter either. -->
        <service
            android:name=".playback.AuralisDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
