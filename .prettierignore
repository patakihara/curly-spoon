pnpm-lock.yaml
dist/
build/
coverage/
android/
.claude/worktrees/

# Sonora, imported with its history via git subtree. Its own conventions govern it;
# reformatting would make every file diverge from the history it arrived with.
design/sonora/
# design-codegen's fixtures are byte-for-byte copies of Sonora files.
design-codegen/src/fixtures/

# The plan's own lint is its formatter, and prettier's table realignment would turn
# one-word edits into whole-table diffs.
docs/plan/

# Plan test fixtures follow the plan's own grammar, which the plan lint checks, not prettier.
scripts/plan/test-fixtures/

# Written by `pnpm gen`; CI compares them byte for byte, so no formatter touches them.
generated/

# Recordings are byte-for-byte what the recorder writes; prettier would reflow short arrays and
# turn every re-record into a formatting diff.
server/src/adapters/*/recordings/
