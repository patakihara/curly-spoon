{
 "browse": {
  "id": "browse",
  "kind": "backdrop",
  "title": {
   "text": "deck.browse"
  },
  "params": {
   "f": {
    "type": "choice",
    "options": [
     {
      "value": "all",
      "label": {
       "text": "browse.all"
      }
     },
     {
      "value": "music",
      "label": {
       "text": "browse.music"
      }
     },
     {
      "value": "audiobooks",
      "label": {
       "text": "browse.audiobooks"
      }
     },
     {
      "value": "podcasts",
      "label": {
       "text": "browse.podcasts"
      }
     }
    ],
    "url": true,
    "motion": "swap"
   },
   "sort": {
    "type": "choice",
    "options": [
     {
      "value": "popular",
      "label": {
       "text": "browse.sort.popular"
      }
     },
     {
      "value": "new",
      "label": {
       "text": "browse.sort.new"
      }
     }
    ],
    "url": true,
    "motion": "swap"
   }
  },
  "back": {
   "header": {
    "items": [
     {
      "kind": "button",
      "name": "menu",
      "label": {
       "text": "drawer.open"
      },
      "action": {
       "nav": {
        "type": "openLayer",
        "layer": "menu"
       }
      },
      "when": {
       "env": "layout",
       "equals": "compact"
      }
     },
     {
      "kind": "logo",
      "name": "logo",
      "label": {
       "text": "app.name"
      }
     },
     {
      "kind": "button",
      "name": "account",
      "label": {
       "text": "account.open"
      },
      "action": null
     }
    ]
   },
   "basicAction": {
    "bind": "f"
   },
   "panel": [
    {
     "kind": "param",
     "bind": "sort",
     "label": {
      "text": "panel.sort"
     }
    }
   ]
  },
  "front": {
   "header": {
    "title": {
     "text": "header.count",
     "args": {
      "label": {
       "derived": "summary",
       "of": "params.f"
      },
      "count": {
       "derived": "total"
      }
     }
    },
    "items": []
   },
   "collapse": "partial",
   "content": {
    "dataSource": "content:browse",
    "presentations": [
     {
      "key": "default"
     }
    ]
   }
  },
  "policy": {
   "params": {
    "f": {
     "default": "all",
     "resetOn": [],
     "scope": null
    },
    "sort": {
     "default": "popular",
     "resetOn": [],
     "scope": null
    }
   },
   "back": {
    "expanded": {
     "default": false,
     "resetOn": [
      "deckSwitch",
      "reselect"
     ],
     "scope": null
    },
    "headerHidden": {
     "default": false,
     "resetOn": [
      "return",
      "paramChange"
     ],
     "scope": null
    }
   },
   "front": {
    "scroll": {
     "default": 0,
     "resetOn": [
      "paramChange",
      "reselect"
     ],
     "scope": null
    }
   }
  }
 },
 "library": {
  "id": "library",
  "kind": "backdrop",
  "title": {
   "text": "deck.library"
  },
  "params": {
   "tab": {
    "type": "choice",
    "axis": true,
    "options": [
     {
      "value": "music",
      "label": {
       "text": "library.music"
      }
     },
     {
      "value": "audiobooks",
      "label": {
       "text": "library.audiobooks"
      }
     },
     {
      "value": "podcasts",
      "label": {
       "text": "library.podcasts"
      }
     }
    ],
    "url": true,
    "motion": "slide"
   },
   "kind": {
    "type": "choice",
    "options": {
     "dataSource": "options:library.kind",
     "params": {
      "tab": {
       "bind": "params.tab"
      }
     }
    },
    "url": true,
    "motion": "swap"
   },
   "genre": {
    "type": "choices",
    "options": {
     "dataSource": "options:library.genre",
     "params": {
      "tab": {
       "bind": "params.tab"
      }
     }
    },
    "url": true,
    "motion": "swap"
   },
   "year": {
    "type": "choice",
    "options": {
     "dataSource": "options:library.year",
     "params": {
      "tab": {
       "bind": "params.tab"
      }
     }
    },
    "url": true,
    "motion": "swap"
   },
   "find": {
    "type": "text"
   },
   "sort": {
    "type": "choice",
    "options": [
     {
      "value": "name",
      "label": {
       "text": "sort.name"
      }
     },
     {
      "value": "year",
      "label": {
       "text": "sort.year"
      }
     },
     {
      "value": "added",
      "label": {
       "text": "sort.added"
      }
     }
    ],
    "url": true,
    "motion": "swap"
   },
   "view": {
    "type": "choice",
    "data": false,
    "options": [
     {
      "value": "grid",
      "label": {
       "text": "view.gridShort"
      }
     },
     {
      "value": "list",
      "label": {
       "text": "view.listShort"
      }
     }
    ],
    "url": true,
    "motion": "swap"
   },
   "years": {
    "type": "number",
    "range": true,
    "min": 1950,
    "max": 2026,
    "step": 1,
    "url": true,
    "motion": "swap"
   }
  },
  "back": {
   "header": {
    "items": [
     {
      "kind": "button",
      "name": "menu",
      "label": {
       "text": "drawer.open"
      },
      "action": {
       "nav": {
        "type": "openLayer",
        "layer": "menu"
       }
      },
      "when": {
       "env": "layout",
       "equals": "compact"
      }
     },
     {
      "kind": "logo",
      "name": "logo",
      "label": {
       "text": "app.name"
      }
     },
     {
      "kind": "button",
      "name": "account",
      "label": {
       "text": "account.open"
      },
      "action": null
     }
    ]
   },
   "basicAction": {
    "bind": "tab"
   },
   "panel": [
    {
     "kind": "param",
     "bind": "kind",
     "label": {
      "text": "library.show"
     }
    },
    {
     "kind": "param",
     "bind": "view",
     "label": {
      "text": "library.layout"
     }
    },
    {
     "kind": "param",
     "bind": "sort",
     "label": {
      "text": "panel.sort"
     }
    },
    {
     "kind": "param",
     "bind": "genre",
     "label": {
      "text": "library.genre"
     }
    },
    {
     "kind": "param",
     "bind": "year",
     "label": {
      "if": {
       "path": "params.tab",
       "equals": "music"
      },
      "then": {
       "text": "library.year"
      },
      "else": {
       "text": "library.when"
      }
     }
    },
    {
     "kind": "param",
     "bind": "years",
     "when": {
      "path": "params.year",
      "equals": "range"
     }
    }
   ]
  },
  "front": {
   "header": {
    "title": {
     "text": "library.header",
     "args": {
      "tab": {
       "bind": "params.tab"
      },
      "kind": {
       "bind": "params.kind"
      },
      "count": {
       "derived": "total"
      }
     }
    },
    "items": [
     {
      "kind": "text",
      "name": "summary",
      "text": {
       "text": "filters.summary",
       "args": {
        "count": {
         "derived": "count",
         "of": "params.genre"
        }
       }
      },
      "when": {
       "all": [
        {
         "path": "back.expanded",
         "equals": false
        },
        {
         "not": {
          "path": "params.genre",
          "equals": []
         }
        }
       ]
      }
     },
     {
      "kind": "find",
      "name": "find",
      "param": "find",
      "placeholder": {
       "text": "find.library",
       "args": {
        "tab": {
         "bind": "params.tab"
        },
        "kind": {
         "bind": "params.kind"
        }
       }
      }
     }
    ]
   },
   "collapse": "partial",
   "content": {
    "dataSource": "content:library",
    "presentations": [
     {
      "key": "grid",
      "groups": [
       {
        "by": "$item.title",
        "key": "initial",
        "when": {
         "path": "params.sort",
         "equals": "name"
        },
        "index": true
       },
       {
        "by": "$item.year",
        "key": "decade",
        "when": {
         "path": "params.sort",
         "equals": "year"
        }
       }
      ]
     },
     {
      "key": "list",
      "groups": [
       {
        "by": "$item.title",
        "key": "initial",
        "when": {
         "path": "params.sort",
         "equals": "name"
        },
        "index": true
       },
       {
        "by": "$item.year",
        "key": "decade",
        "when": {
         "path": "params.sort",
         "equals": "year"
        }
       }
      ]
     }
    ],
    "view": "view"
   }
  },
  "policy": {
   "params": {
    "tab": {
     "default": "music",
     "resetOn": [],
     "scope": null
    },
    "kind": {
     "default": "collections",
     "resetOn": [],
     "scope": "params.tab"
    },
    "genre": {
     "default": [],
     "resetOn": [],
     "scope": "params.tab"
    },
    "year": {
     "default": "any",
     "resetOn": [],
     "scope": "params.tab"
    },
    "find": {
     "default": "",
     "resetOn": [
      {
       "paramChange": "tab"
      }
     ],
     "scope": null
    },
    "sort": {
     "default": "name",
     "resetOn": [],
     "scope": "params.tab"
    },
    "view": {
     "default": "grid",
     "resetOn": [],
     "scope": "params.tab"
    },
    "years": {
     "default": [
      2000,
      2026
     ],
     "resetOn": [],
     "scope": "params.tab"
    }
   },
   "back": {
    "expanded": {
     "default": false,
     "resetOn": [
      "deckSwitch",
      "reselect"
     ],
     "scope": null,
     "on": [
      {
       "event": {
        "paramChange": "tab"
       },
       "set": true
      },
      {
       "event": {
        "paramReselect": "tab"
       },
       "set": "toggle"
      }
     ]
    },
    "headerHidden": {
     "default": false,
     "resetOn": [
      "return",
      "paramChange"
     ],
     "scope": null
    }
   },
   "front": {
    "scroll": {
     "default": 0,
     "resetOn": [
      "paramChange",
      "reselect"
     ],
     "scope": null
    },
    "find": {
     "opened": {
      "default": false,
      "resetOn": [
       "scrollTop",
       {
        "paramChange": "tab"
       }
      ],
      "scope": null
     },
     "closed": {
      "default": false,
      "resetOn": [
       "scrollTop",
       {
        "paramChange": "tab"
       }
      ],
      "scope": null
     }
    }
   }
  }
 },
 "search": {
  "id": "search",
  "kind": "backdrop",
  "title": {
   "text": "deck.search"
  },
  "params": {
   "q": {
    "type": "text",
    "url": true,
    "history": "pushFirst"
   },
   "view": {
    "type": "choice",
    "data": false,
    "options": [
     {
      "value": "list",
      "label": {
       "text": "view.list"
      }
     },
     {
      "value": "grid",
      "label": {
       "text": "view.grid"
      }
     }
    ]
   },
   "qd": {
    "type": "text",
    "data": false
   }
  },
  "back": {
   "header": {
    "items": [
     {
      "kind": "button",
      "name": "menu",
      "label": {
       "text": "drawer.open"
      },
      "action": {
       "nav": {
        "type": "openLayer",
        "layer": "menu"
       }
      },
      "when": {
       "env": "layout",
       "equals": "compact"
      }
     },
     {
      "kind": "logo",
      "name": "logo",
      "label": {
       "text": "app.name"
      }
     },
     {
      "kind": "button",
      "name": "account",
      "label": {
       "text": "account.open"
      },
      "action": null
     }
    ]
   },
   "basicAction": {
    "bind": {
     "change": "qd",
     "submit": "q"
    },
    "placeholder": {
     "text": "search.anything"
    }
   },
   "panel": [
    {
     "kind": "suggestions",
     "label": {
      "if": {
       "path": "params.qd",
       "equals": ""
      },
      "then": {
       "text": "search.popular"
      },
      "else": {
       "text": "search.suggestions"
      }
     },
     "source": {
      "dataSource": "suggest",
      "params": {
       "prefix": {
        "bind": "params.qd"
       }
      }
     },
     "fills": {
      "change": "qd",
      "submit": "q"
     }
    }
   ]
  },
  "front": {
   "header": {
    "title": {
     "if": {
      "path": "params.q",
      "equals": ""
     },
     "then": {
      "text": "header.count",
      "args": {
       "label": {
        "text": "search.all"
       },
       "count": {
        "derived": "total"
       }
      }
     },
     "else": {
      "text": "search.results",
      "args": {
       "query": {
        "bind": "params.q"
       },
       "count": {
        "derived": "total"
       }
      }
     }
    },
    "items": [
     {
      "kind": "switch",
      "name": "view",
      "param": "view",
      "label": {
       "if": {
        "path": "params.view",
        "equals": "list"
       },
       "then": {
        "text": "view.grid"
       },
       "else": {
        "text": "view.list"
       }
      },
      "when": {
       "path": "back.expanded",
       "equals": false
      }
     }
    ]
   },
   "collapse": "full",
   "content": {
    "dataSource": "content:search",
    "presentations": [
     {
      "key": "list"
     },
     {
      "key": "grid"
     }
    ],
    "view": "view"
   }
  },
  "policy": {
   "params": {
    "q": {
     "default": "",
     "resetOn": [],
     "scope": null
    },
    "view": {
     "default": "list",
     "resetOn": [],
     "scope": null
    },
    "qd": {
     "default": "",
     "resetOn": [],
     "scope": null
    }
   },
   "back": {
    "expanded": {
     "default": true,
     "resetOn": [
      "deckSwitch",
      "reselect"
     ],
     "scope": null,
     "on": [
      {
       "event": {
        "paramChange": "q"
       },
       "set": false
      }
     ]
    },
    "headerHidden": {
     "default": false,
     "resetOn": [
      "return",
      "paramChange"
     ],
     "scope": null
    }
   },
   "front": {
    "scroll": {
     "default": 0,
     "resetOn": [
      "paramChange",
      "reselect"
     ],
     "scope": null
    }
   }
  }
 },
 "shelfPage": {
