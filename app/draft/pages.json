    "find": {
     "default": "",
     "resetOn": [],
     "scope": null
    },
    "genre": {
     "default": [],
     "resetOn": [],
     "scope": null
    }
   },
   "back": {
    "expanded": {
     "default": false,
     "resetOn": [
      "deckSwitch",
      "reselect"
     ],
     "scope": null
    },
    "headerHidden": {
     "default": false,
     "resetOn": [
      "return",
      "paramChange"
     ],
     "scope": null
    }
   },
   "front": {
    "scroll": {
     "default": 0,
     "resetOn": [
      "paramChange",
      "reselect"
     ],
     "scope": null
    },
    "find": {
     "opened": {
      "default": false,
      "resetOn": [
       "scrollTop"
      ],
      "scope": null
     },
     "closed": {
      "default": false,
      "resetOn": [
       "scrollTop"
      ],
      "scope": null
     }
    }
   }
  }
 },
 "person": {
  "id": "person",
  "kind": "backdrop",
  "title": {
   "from": "item"
  },
  "params": {
   "section": {
    "type": "choice",
    "axis": true,
    "motion": "slide",
    "options": {
     "dataSource": "options:person.section",
     "params": {
      "id": {
       "bind": "$opener.id"
      }
     }
    }
   },
   "find": {
    "type": "text"
   },
   "sort": {
    "type": "choice",
    "options": [
     {
      "value": "year",
      "label": {
       "text": "sort.newest"
      }
     },
     {
      "value": "name",
      "label": {
       "text": "sort.name"
      }
     }
    ],
    "motion": "swap"
   },
   "when": {
    "type": "choice",
    "options": {
     "dataSource": "options:person.when",
     "params": {
      "id": {
       "bind": "$opener.id"
      }
     }
    },
    "motion": "swap"
   }
  },
  "back": {
   "header": {
    "items": [
     {
      "kind": "button",
      "name": "up",
      "label": {
       "text": "action.back"
      },
      "action": {
       "nav": {
        "type": "up"
       }
      }
     }
    ],
    "detail": {
     "title": {
      "bind": "$opener.title"
     },
     "subtitle": {
      "bind": "$opener.subtitle"
     },
     "image": {
      "bind": "$opener.image"
     },
     "meta": {
      "text": "person.counts",
      "args": {
       "collections": {
        "bind": "$opener.collectionCount"
       },
       "tracks": {
        "bind": "$opener.trackCount"
       }
      }
     }
    }
   },
   "actions": [
    {
     "kind": "button",
     "name": "playNow",
     "label": {
      "text": "action.playNow"
     },
     "action": {
      "player": {
       "type": "playQueue",
       "tracks": {
        "bind": "$opener.tracks"
       }
      }
     },
     "when": {
      "player": "queue",
      "of": "$opener.tracks",
      "equals": "empty"
     }
    },
    {
     "kind": "button",
     "name": "playNext",
     "label": {
      "text": "action.playNext"
     },
     "action": {
      "player": {
       "type": "enqueue",
       "next": true,
       "tracks": {
        "bind": "$opener.tracks"
       }
      }
     },
     "when": {
      "player": "queue",
      "of": "$opener.tracks",
      "equals": "absent"
     }
    },
    {
     "kind": "button",
     "name": "playLast",
     "label": {
      "text": "action.playLast"
     },
     "action": {
      "player": {
       "type": "enqueue",
       "tracks": {
        "bind": "$opener.tracks"
       }
      }
     },
     "when": {
      "player": "queue",
      "of": "$opener.tracks",
      "equals": "contains"
     }
    }
   ],
   "basicAction": {
    "bind": "section"
   },
   "panel": [
    {
     "kind": "param",
