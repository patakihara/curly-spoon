node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# test output
playwright-report/
test-results/
blob-report/
.playwright/
# A signed-in browser state, written by e2e/app/onboarding.spec.ts for the rest
# of the suite. Regenerated every run; committing it would commit a session cookie.
e2e/.auth/

# runtime data — anchored to apps/server specifically: a bare `data/` matches any
# directory named `data` anywhere in the tree, which silently swallowed the Android
# app's `net.develivarr.auralis.data` package (phase 7 wave A) until this was caught.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
apps/server/data/
.env
.env.*
!.env.example

# Claude Code worktrees live inside the repo and git does not auto-ignore a
# nested worktree — untracked, it reads as a mountain of phantom work.
.claude/worktrees/

# Personal, per-checkout Claude Code overrides — Claude Code's own convention
# for local settings not meant to be committed to this public repo (unlike
# .claude/settings.json, which is team-visible policy). Currently holds the
# quiet-hours prompt-queuing hook, a personal habit-management preference,
# not project policy.
.claude/settings.local.json
# The quiet-hours hook's queue: raw prompt text plus timestamps, written by
# scripts/hooks/time-gate.sh. Never belongs in a public repo.
.claude/deferred-prompts.jsonl

# The subagent-activity log's lockfile and crash-leftover temp files, written
# by scripts/hooks/agent-log.sh around its read-modify-write of
# docs/HANDOVER.md. Neither is meaningful content — the lock is empty, and a
# .tmp.<pid> file only survives if the hook was killed mid-write.
docs/.HANDOVER.md.lock
docs/.HANDOVER.md.tmp.*

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# android
apps/android/.gradle/
apps/android/local.properties
apps/android/**/build/
apps/android/.cxx/
# Kotlin compile-daemon session files, written under the module root by any
# Gradle invocation — never source, and noisy in `git status`.
apps/android/.kotlin/
*.keystore

# python bytecode from scripts/
__pycache__/
*.pyc

# The user's own Spotify screenshots, used as phase 12 design references.
# Personal listening data; this repo is public. Kept on disk, out of git,
# pending the user's decision -- see docs/ROADMAP.md §12.
docs/research/spec-addendum/
