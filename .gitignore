node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# test output
playwright-report/
test-results/
blob-report/
.playwright/
# A signed-in browser state, written by e2e/app/onboarding.spec.ts for the rest
# of the suite. Regenerated every run; committing it would commit a session cookie.
e2e/.auth/

# runtime data
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/
.env
.env.*
!.env.example

# Claude Code worktrees live inside the repo and git does not auto-ignore a
# nested worktree — untracked, it reads as a mountain of phantom work.
.claude/worktrees/

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# android
apps/android/.gradle/
apps/android/local.properties
apps/android/**/build/
apps/android/.cxx/
# Kotlin compile-daemon session files, written under the module root by any
# Gradle invocation — never source, and noisy in `git status`.
apps/android/.kotlin/
*.keystore

# python bytecode from scripts/
__pycache__/
*.pyc
