{
  "openapi": "3.1.0",
  "info": {
    "title": "Auralis API",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auralis_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          }
        },
        "required": [
          "configured"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "username",
          "role"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "SetupBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "username"
        ]
      },
      "ClientKind": {
        "type": "string",
        "enum": [
          "web",
          "android"
        ],
        "default": "web"
      },
      "AppToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        },
        "required": [
          "token",
          "deviceId",
          "expiresAt"
        ]
      },
      "TokenBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "codeVerifier": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "code",
          "codeVerifier"
        ]
      },
      "Service": {
        "type": "string",
        "enum": [
          "abs",
          "jellyfin"
        ]
      },
      "LinkState": {
        "type": "string",
        "enum": [
          "linked",
          "unlinked",
          "stale",
          "error"
        ]
      },
      "LinkStatus": {
        "type": "object",
        "properties": {
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "state": {
            "$ref": "#/components/schemas/LinkState"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "service",
          "state",
          "detail"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "deviceId": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LinkStatus"
            }
          }
        },
        "required": [
          "username",
          "role",
          "deviceId",
          "links"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "lastSeenAt": {
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "createdAt",
          "lastSeenAt",
          "current"
        ]
      },
      "DeviceList": {
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        },
        "required": [
          "devices"
        ]
      },
      "RenameDeviceBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name"
        ]
      },
      "UserList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Me"
            }
          }
        },
        "required": [
          "users"
        ]
      },
      "PlaybackTrack": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "offset": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "url",
          "mime",
          "duration",
          "offset"
        ]
      },
      "PlaybackChapter": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "start",
          "end"
        ]
      },
      "ProgressTarget": {
        "type": "object",
        "properties": {
          "playId": {
            "type": "string"
          }
        },
        "required": [
          "playId"
        ]
      },
      "MediaSource": {
        "type": "string",
        "enum": [
          "abs"
        ]
      },
      "MediaRef": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/MediaSource"
          },
          "id": {
            "type": "string",
            "pattern": "^[\\w-]{1,64}$"
          }
        },
        "required": [
          "source",
          "id"
        ]
      },
      "PlaybackPlan": {
        "type": "object",
        "properties": {
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaybackTrack"
            },
            "minItems": 1
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaybackChapter"
            }
          },
          "startAt": {
            "type": "number",
            "minimum": 0
          },
          "progressTarget": {
            "$ref": "#/components/schemas/ProgressTarget"
          },
          "next": {
            "$ref": "#/components/schemas/MediaRef"
          }
        },
        "required": [
          "tracks",
          "chapters",
          "startAt"
        ]
      },
      "PlayBody": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "#/components/schemas/MediaRef"
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Whether the server is up",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The server is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "get": {
        "summary": "Whether an admin has been claimed",
        "operationId": "getSetup",
        "responses": {
          "200": {
            "description": "Whether setup has run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Claim admin with the one-time code, or, as an admin, make another username admin",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "postSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user who is now an admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "summary": "Start signing in through the household sign-on",
        "operationId": "login",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/ClientKind"
            },
            "required": false,
            "name": "client",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "required": false,
            "name": "return_to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "required": false,
            "name": "code_challenge",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "required": false,
            "name": "app_state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "required": false,
            "name": "device_id",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Sent on to the sign-on.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "summary": "Finish signing in: the sign-on sends the browser back here",
        "operationId": "loginCallback",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "required": false,
            "name": "error",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in: back to the web app, or on to the Android app with a code.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token": {
      "post": {
        "summary": "Swap the Android app's one-time code for its bearer token",
        "operationId": "appToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The app's token and device.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppToken"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Who is signed in, on which device, and their upstream links",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sign out of this session",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "summary": "The signed-in user's own devices",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "listDevices",
        "responses": {
          "200": {
            "description": "Every device this user has signed in from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceList"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{id}": {
      "patch": {
        "summary": "Rename one of your own devices",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "renameDevice",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameDeviceBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The renamed device.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove one of your own devices, signing it out",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "deleteDevice",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The device and its sessions are gone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "Who can sign in, and their role",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "Every user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/play": {
      "post": {
        "summary": "Plan how to play an item, as the signed-in person",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "play",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tracks to play, streamed through this server, and where to start.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackPlan"
                }
              }
            }
          },
          "400": {
            "description": "The request does not parse, or was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Without the role this route needs, or sent from another site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/media/{ref}/tracks/{n}": {
      "get": {
        "summary": "One track of an item, with the signed-in person's own access, ranges and all",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "operationId": "getMediaTrack",
        "parameters": [
          {
