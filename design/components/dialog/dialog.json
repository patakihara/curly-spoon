{
  "extends": "surface",
  "props": {
    "title": "string",
    "body": "string",
    "confirm": "string",
    "cancel": "string",
    "confirmLabel": "string",
    "cancelLabel": "string"
  },
  "provides": {
    "content": {
      "token": "color.onSurface"
    },
    "contentVariant": {
      "token": "color.onSurface"
    },
    "focusRing": {
      "token": "color.focusRing"
    }
  },
  "visuals": {
    "scrim": {
      "default": {
        "token": "color.scrim"
      }
    },
    "fill": {
      "default": {
        "token": "color.surfaceRaised"
      }
    },
    "radius": {
      "default": 16
    },
    "padding": {
      "default": 24
    },
    "gap": {
      "default": 12
    },
    "maxWidth": {
      "default": 320
    },
    "shadow": {
      "default": "0 12px 32px rgba(0,0,0,.2)"
    },
    "titleSize": {
      "default": 20
    },
    "titleWeight": {
      "default": 500
    },
    "bodySize": {
      "default": 14
    },
    "bodyInk": {
      "default": {
        "token": "color.onSurfaceSubtle"
      }
    },
    "actionsGap": {
      "default": 8
    },
    "actionsTop": {
      "default": 8
    },
    "confirmEmphasis": {
      "default": "filled"
    },
    "cancelEmphasis": {
      "default": "text"
    }
  },
  "events": [
    {
      "name": "close",
      "payload": "value"
    }
  ]
}
