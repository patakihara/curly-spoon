{
  "implements": [
    "input"
  ],
  "accepts": [
    "number"
  ],
  "props": {
    "value": "value",
    "options": "options",
    "fromLabel": "string",
    "toLabel": "string",
    "min": "number",
    "max": "number"
  },
  "visuals": {
    "height": {
      "default": 40
    },
    "radius": {
      "default": {
        "token": "radius.sm"
      }
    },
    "border": {
      "default": {
        "token": "color.chipOutline"
      }
    },
    "ink": {
      "default": {
        "role": "content"
      }
    },
    "width": {
      "default": 88
    },
    "gap": {
      "default": 8
    },
    "fontSize": {
      "default": 14
    },
    "padX": {
      "default": 10
    },
    "separatorOpacity": {
      "default": 0.8
    }
  },
  "events": [
    {
      "name": "change",
      "payload": "value"
    }
  ]
}
