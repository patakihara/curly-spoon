{
  "extends": "interactive",
  "props": {
    "value": "value",
    "options": "options",
    "label": "string"
  },
  "visuals": {
    "radius": {
      "default": {
        "token": "radius.sm"
      }
    },
    "height": {
      "default": 40
    },
    "border": {
      "default": {
        "token": "color.chipOutline"
      }
    },
    "ink": {
      "default": {
        "role": "content"
      }
    },
    "optionInk": {
      "default": {
        "token": "color.onSurface"
      }
    },
    "fontSize": {
      "default": 14
    },
    "padX": {
      "default": 10
    }
  },
  "placeholder": {
    "visuals": {
      "bar": {
        "default": {
          "token": "color.placeholder"
        }
      }
    }
  },
  "events": [
    {
      "name": "change",
      "payload": "value"
    }
  ]
}
