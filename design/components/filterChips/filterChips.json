{
  "props": {
    "value": "value",
    "options": "options",
    "more": "boolean",
    "moreLabel": "string"
  },
  "placeholder": {
    "visuals": {
      "bar": {
        "default": {
          "token": "color.placeholder"
        }
      },
      "barStrong": {
        "default": {
          "token": "color.placeholderStrong"
        }
      }
    }
  },
  "motion": {
    "placeholder": [
      {
        "do": "kind",
        "kind": "pulse",
        "trigger": "loop",
        "ms": {
          "token": "motion.duration.pulse"
        },
        "easing": {
          "token": "motion.easing.smooth"
        }
      }
    ]
  },
  "visuals": {
    "height": {
      "default": 48
    },
    "gap": {
      "default": 8
    },
    "inset": {
      "default": 16
    },
    "moreAfter": {
      "default": 4
    }
  },
  "events": [
    {
      "name": "change",
      "payload": "value"
    },
    {
      "name": "toggle",
      "payload": "string"
    },
    {
      "name": "more",
      "payload": null
    }
  ],
  "optional": [
    "more",
    "moreLabel"
  ]
}
