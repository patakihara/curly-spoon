{
  "extends": "surface",
  "props": {
    "title": "string",
    "subtitle": "string"
  },
  "provides": {
    "content": {
      "token": "color.onSurface"
    },
    "contentVariant": {
      "token": "color.onSurface"
    },
    "focusRing": {
      "token": "color.focusRing"
    }
  },
  "visuals": {
    "fill": {
      "default": "#fff"
    },
    "radius": {
      "default": 12
    },
    "shadow": {
      "default": "0 2px 6px rgba(0,0,0,.12), 0 8px 24px rgba(0,0,0,.10)"
    },
    "stateLayer": {
      "hover": {
        "token": "state.hover.opacity.default"
      },
      "pressed": {
        "token": "state.pressed.opacity.default"
      },
      "keyboardFocus": {
        "token": "state.focus.opacity"
      }
    },
    "ripple": {
      "default": {
        "token": "state.ripple.opacity.default"
      }
    },
    "cursor": {
      "default": "pointer",
      "disabled": "default"
    }
  }
}
