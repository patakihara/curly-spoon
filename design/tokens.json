      },
      "emphasized": {
        "$value": "cubic-bezier(.2,0,0,1)",
        "$type": "cubicBezier"
      },
      "inOutSoftEnd": {
        "$value": "cubic-bezier(.45,0,.1,1)",
        "$type": "cubicBezier",
        "$description": "ease in and out; the landing (end) softer than the start"
      },
      "emphasizedDecelerate": {
        "$value": "cubic-bezier(.05,.7,.1,1)",
        "$type": "cubicBezier"
      },
      "smooth": {
        "$value": "cubic-bezier(.37,0,.63,1)",
        "$type": "cubicBezier"
      }
    },
    "fadeThrough": {
      "split": {
        "$value": 0.3,
        "$type": "number"
