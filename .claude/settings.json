{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "bgIsolation": "worktree",
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Reading plan usage"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/guards/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "Reading plan progress"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Checking plan usage"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Checking plan usage"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/guards/generated-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/guards/stop-publish.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the published artifacts"
          }
        ]
      }
    ]
  }
}
