{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Reading plan usage"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Checking plan usage"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/usage-gate.sh\"",
            "timeout": 20,
            "statusMessage": "Checking plan usage"
          }
        ]
      }
    ]
  }
}
