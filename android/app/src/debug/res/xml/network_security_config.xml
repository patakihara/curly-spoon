<?xml version="1.0" encoding="utf-8"?>
<!-- A debug build reaches the local server over plain HTTP: the emulator's host (10.0.2.2) and
     this device itself, where `adb reverse` forwards the test server. Everything else, and every
     release build, keeps HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
