# Only what the image needs goes into the build context: the workspace manifests, server/ and
# web/. Sonora reaches the web build through web/src/generated, so design/ stays out.
.git
.gitignore
.github
.githooks
.claude
android
design
docs
metadata
scripts

node_modules
**/node_modules
**/dist
**/build
**/coverage

.env
.env.*
.DS_Store
*.log

# The image runs server/src/main.ts and what it imports, nothing else: no tests, no recordings
# or the recorder, and never the recorded-upstreams harness. scripts/guards/image.test.mjs holds
# the context to exactly that, and CI's container job checks the built image.
server/e2e
server/src/**/*.test.ts
server/src/adapters/*/recordings
server/src/adapters/oidc
server/src/adapters/record-*.ts
server/src/adapters/http/*
!server/src/adapters/http/fetch.ts
